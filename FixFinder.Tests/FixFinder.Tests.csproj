<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless unit tests over FixFinder.Core. Plain net8.0 (no UseWindowsForms, unlike
    ShoppingCartAppUiTests, which needs it for FlaUI) because nothing here touches a UI or a
    real desktop session - the parsers, fingerprinter, diff engine, path mapper and ranker
    are all pure functions over text.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FixFinder.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixFinder.Core\FixFinder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Captured crash output, recorded HTTP responses, sample diffs and source trees. The C# programs among them are what was
      run to capture an output, not part of the tests, so they are copied and never compiled.
    -->
    <Compile Remove="Fixtures\**" />
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />

    <!--
      How many tests run at once, which xunit reads from xunit.runner.json: at most twice as many as the computer has
      processors, and another starts only when one has finished - xunit's conservative way, written out rather than left to
      its default. xunit 2.5.3 started every test class at once, and another whenever a test was waiting, so on the runner's
      four processors from 165 to 309 tests of ten seconds or more were running at the same moment, and live tests that take
      seconds on their own took minutes there, and some ran out of time.
    -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="SelfSignForWdac" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec ContinueOnError="true"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\sign-for-wdac.ps1&quot; -TargetPath &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
