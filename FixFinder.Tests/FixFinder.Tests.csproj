<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless unit tests over FixFinder.Core. Plain net8.0 (no UseWindowsForms, unlike
    ShoppingCartAppUiTests, which needs it for FlaUI) because nothing here touches a UI or a
    real desktop session - the parsers, fingerprinter, diff engine, path mapper and ranker
    are all pure functions over text.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FixFinder.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />

    <!--
      Not used directly. xunit's netstandard1.x dependencies pull in System.Net.Http 4.3.0 and
      System.Text.RegularExpressions 4.3.0, both with high-severity advisories (GHSA-7jgj-8wvc-jh57,
      GHSA-cmhx-cq75-c4mj). Referencing the patched versions here makes restore pick them instead;
      dotnet's package listing with its vulnerable and include-transitive options checks it.
    -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixFinder.Core\FixFinder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured crash output, recorded HTTP responses, sample diffs and source trees. -->
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="SelfSignForWdac" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec ContinueOnError="true"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\sign-for-wdac.ps1&quot; -TargetPath &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
