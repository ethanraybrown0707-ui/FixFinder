<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FixFinder from a terminal, or from an editor's task. Everything it does is in FixFinder.Core's
    CommandLine, where the tests can reach it; this project only hands it the command line and the
    console. The assembly is called fixfinder so the command reads the way it is typed.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FixFinder.Cli</RootNamespace>
    <AssemblyName>fixfinder</AssemblyName>
    <Company>Ethan Brown</Company>
    <Authors>Ethan Brown</Authors>
    <Product>FixFinder</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixFinder.Core\FixFinder.Core.csproj" />
  </ItemGroup>

  <Target Name="SelfSignForWdac" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec ContinueOnError="true"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\sign-for-wdac.ps1&quot; -TargetPath &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
