<!--
    The light theme, and the one FixFinder has always used. Every key here exists in Dark.xaml too: a brush defined in
    one and not the other would leave a control painted in whatever it inherited, which reads as a rendering fault.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E7EF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD3DF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F4FA"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E3E9F2"/>

    <SolidColorBrush x:Key="TextBrush" Color="#16202E"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4F5B6E"/>
    <SolidColorBrush x:Key="HintBrush" Color="#7A8599"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#1A6DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1558D6"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1247B3"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#D92D20"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEF3F2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FDCBC6"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C4570B"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF5EB"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FCD9B4"/>
    <SolidColorBrush x:Key="SuggestionBrush" Color="#1A6DFF"/>
    <SolidColorBrush x:Key="SuggestionSoftBrush" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="SuggestionBorderBrush" Color="#C9DAFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#12823B"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B7EBC8"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#D92D20"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF3F2"/>

    <!-- The before-and-after sits on the same dark code background as the corrected code, so the tints are what
         red and green become there: enough to read a line's fate from its colour, not enough to fight the code. -->
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#3B1A1C"/>
    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#FDA29B"/>
    <SolidColorBrush x:Key="DiffRemovedMarkBrush" Color="#7A2822"/>
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#102A1C"/>
    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#8FE0A8"/>
    <SolidColorBrush x:Key="DiffAddedMarkBrush" Color="#1C5334"/>
    <SolidColorBrush x:Key="DiffGutterBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="CodeBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="CodeTextBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ConsoleBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ConsoleErrorBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="ConsoleSelectedBrush" Color="#1E293B"/>

</ResourceDictionary>
