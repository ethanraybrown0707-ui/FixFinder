<Window x:Class="FixFinder.Gui.FixFoundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FixFinder - search results" Height="620" Width="780" MinHeight="440" MinWidth="620"
        Icon="Assets/FixFinder.ico"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="22,16">
            <StackPanel>
                <TextBlock x:Name="HeadlineText" AutomationProperties.AutomationId="HeadlineText"
                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="FoundErrorText"
                           Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="{StaticResource CodeFont}" FontSize="12"
                           Foreground="{DynamicResource ErrorBrush}"/>
            </StackPanel>
        </Border>

        <Rectangle Grid.Row="1" Height="3" Fill="{DynamicResource BrandBlendBrush}"/>

        <Grid Grid.Row="2" Margin="22,16,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="CandidateTitleText" AutomationProperties.AutomationId="FoundCandidateTitleText"
                               FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14"/>
                    <TextBlock x:Name="CandidateSourceText" AutomationProperties.AutomationId="FoundCandidateSourceText"
                               Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                        <Hyperlink x:Name="CandidateLink" RequestNavigate="Hyperlink_RequestNavigate"
                                   AutomationProperties.AutomationId="FoundCandidateLink">
                            <TextBlock x:Name="CandidateUrlText" TextWrapping="Wrap" FontSize="12"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="AttributionText" AutomationProperties.AutomationId="FoundAttributionText"
                               Style="{StaticResource Hint}" FontStyle="Italic" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" x:Name="ExplanationText" AutomationProperties.AutomationId="FoundExplanationText"
                       Style="{StaticResource Body}" Margin="0,0,0,10"/>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" x:Name="ContentHeaderText" Style="{StaticResource Label}" Margin="0,0,0,6"
                           Text="WHAT IT CHANGES"/>
                <Border Background="{DynamicResource CodeBrush}" CornerRadius="10" Padding="0,8">
                    <ListBox x:Name="ContentListBox" AutomationProperties.AutomationId="FoundContentListBox"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="{StaticResource CodeFont}" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource CodeTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                    <Setter Property="Foreground" Value="#86EFAC"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                    <Setter Property="Foreground" Value="#FCA5A5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#93C5FD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,12" Margin="0,16,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="OtherResultsText" AutomationProperties.AutomationId="OtherResultsText" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="CopiedText" AutomationProperties.AutomationId="CopiedText" Style="{StaticResource Hint}"
                               Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton" AutomationProperties.AutomationId="CopyFixButton" Style="{StaticResource PrimaryButton}"
                            Content="Copy the fix" IsEnabled="False" Click="CopyButton_Click"/>
                    <Button x:Name="NextResultButton" AutomationProperties.AutomationId="NextResultButton"
                            Content="Next result" Margin="8,0,0,0" Click="NextResultButton_Click"/>
                    <Button x:Name="OpenPageButton" AutomationProperties.AutomationId="OpenPageButton"
                            Content="Open the page" Margin="8,0,0,0" Click="OpenPageButton_Click"/>
                    <Button x:Name="CloseButton" AutomationProperties.AutomationId="FoundCloseButton"
                            Content="Close" Margin="8,0,0,0" IsCancel="True" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
