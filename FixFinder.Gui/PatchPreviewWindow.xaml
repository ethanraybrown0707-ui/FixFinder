<Window x:Class="FixFinder.Gui.PatchPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Preview the change" Height="760" Width="1000" MinHeight="560" MinWidth="760"
        Icon="Assets/FixFinder.ico"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DiffItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== what this is ============================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="CandidateTitleText"
                       AutomationProperties.AutomationId="PreviewCandidateTitleText"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="CandidateUrlText"
                       AutomationProperties.AutomationId="PreviewCandidateUrlText"
                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            <TextBlock x:Name="AttributionText"
                       AutomationProperties.AutomationId="PreviewAttributionText"
                       Style="{StaticResource Hint}" FontStyle="Italic" Margin="0,2,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- =============================== the verdict ============================== -->
        <Border Grid.Row="1" x:Name="VerdictBorder" BorderThickness="1" CornerRadius="2"
                Padding="8" Margin="0,0,0,8"
                BorderBrush="#BDBDBD" Background="#F5F5F5">
            <StackPanel>
                <TextBlock x:Name="VerdictText" AutomationProperties.AutomationId="PreviewVerdictText"
                           FontWeight="SemiBold" TextWrapping="Wrap" Text="Fetching the patch..."/>
                <TextBlock x:Name="VerdictDetailText" AutomationProperties.AutomationId="PreviewVerdictDetailText"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================== mapped paths ============================== -->
        <GroupBox Grid.Row="2" Header="Files this would change" Margin="0,0,0,8">
            <ListBox x:Name="MappedPathsListBox"
                     AutomationProperties.AutomationId="MappedPathsListBox"
                     FontFamily="Consolas" MaxHeight="110"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource DiffItemContainerStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#202020"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNote}" Value="True">
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- ================================= the diff =============================== -->
        <TabControl Grid.Row="3" x:Name="ContentTabs" AutomationProperties.AutomationId="PreviewContentTabs">
            <TabItem x:Name="DiffTab" AutomationProperties.AutomationId="DiffTab" Header="The change">
                <ListBox x:Name="DiffListBox" AutomationProperties.AutomationId="DiffListBox"
                         FontFamily="Consolas" VirtualizingPanel.IsVirtualizing="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource DiffItemContainerStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#202020"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#0D47A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem x:Name="SnippetsTab" AutomationProperties.AutomationId="SnippetsTab"
                     Header="Code to read">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="4"
                               Text="Code blocks from the discussion that are not unified diffs. FixFinder cannot apply these - turning prose into a patch needs a language model, and there is not one in this tool - but this is usually where the actual answer is written out."/>

                    <ListBox Grid.Row="1" x:Name="SnippetsListBox"
                             AutomationProperties.AutomationId="SnippetsListBox"
                             FontFamily="Consolas" VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource DiffItemContainerStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#202020"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#0D47A1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================== after applying ============================= -->
        <Border Grid.Row="4" x:Name="OutcomeBorder" BorderThickness="1" CornerRadius="2"
                Padding="8" Margin="0,8,0,0" Visibility="Collapsed"
                BorderBrush="#BDBDBD" Background="#F5F5F5">
            <StackPanel>
                <TextBlock x:Name="OutcomeText" AutomationProperties.AutomationId="PreviewOutcomeText"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackupPathText" AutomationProperties.AutomationId="PreviewBackupPathText"
                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="VerificationText" AutomationProperties.AutomationId="PreviewVerificationText"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ================================ the gate ================================ -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <CheckBox x:Name="DryRunCheckBox" AutomationProperties.AutomationId="DryRunCheckBox"
                          Content="Dry run — show what would happen and write nothing"
                          IsChecked="True" Checked="DryRun_Changed" Unchecked="DryRun_Changed"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="To write these changes, type" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConfirmationWordText" AutomationProperties.AutomationId="ConfirmationWordText"
                               Text=" APPLY " FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock Text="here:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ConfirmationText" AutomationProperties.AutomationId="ConfirmationText"
                             AutomationProperties.Name="Type APPLY to confirm"
                             Width="120" FontFamily="Consolas" VerticalAlignment="Center"
                             IsEnabled="False" TextChanged="ConfirmationText_TextChanged"/>
                </StackPanel>

                <TextBlock x:Name="GateHintText" AutomationProperties.AutomationId="GateHintText"
                           Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Nothing is written while dry run is ticked. Every file is copied to a backup folder first, and the backup is never deleted automatically."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ApplyButton" AutomationProperties.AutomationId="ApplyButton"
                        Content="Apply" Padding="16,5" IsEnabled="False" Click="ApplyButton_Click"/>
                <Button x:Name="RollbackButton" AutomationProperties.AutomationId="RollbackButton"
                        Content="Roll back" Padding="14,5" Margin="8,0,0,0" IsEnabled="False"
                        Click="RollbackButton_Click"/>
                <Button x:Name="CloseButton" AutomationProperties.AutomationId="PreviewCloseButton"
                        Content="Close" Padding="14,5" Margin="8,0,0,0" IsCancel="True"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
