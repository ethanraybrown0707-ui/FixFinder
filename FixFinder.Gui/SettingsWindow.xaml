<Window x:Class="FixFinder.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FixFinder settings" Width="700" Height="820" MinHeight="480"
        Icon="Assets/FixFinder.ico"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" TextBlock.FontSize="15" TextBlock.FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,16">
            <TextBlock x:Name="SettingsStatusText"
                       AutomationProperties.AutomationId="SettingsStatusText"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontStyle="Italic"/>
            <Button x:Name="SaveSettingsButton" AutomationProperties.AutomationId="SaveSettingsButton" Style="{StaticResource PrimaryButton}"
                    Content="Save" Padding="18,7" IsDefault="True" Click="SaveSettingsButton_Click"/>
            <Button x:Name="CancelSettingsButton" AutomationProperties.AutomationId="CancelSettingsButton"
                    Content="Cancel" Padding="18,7" Margin="8,0,0,0" IsCancel="True"
                    Click="CancelSettingsButton_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,18,18,0">

                <GroupBox Header="Language versions" Margin="0,0,0,12">
                    <StackPanel Margin="4">
                        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,10"
                                   Text="The version your course uses. Programs are built with it, and every fix is compiled with it before it is offered - so a fix that needs a later version is never shown. Python, JavaScript and Go run on whatever is installed."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="C" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CStandardBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                      SelectionChanged="Standard_Changed"
                                      AutomationProperties.AutomationId="CStandardBox" AutomationProperties.Name="C version"/>

                            <TextBlock Grid.Row="1" Text="C++" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CppStandardBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                      SelectionChanged="Standard_Changed"
                                      AutomationProperties.AutomationId="CppStandardBox" AutomationProperties.Name="C++ version"/>

                            <TextBlock Grid.Row="2" Text="Java" VerticalAlignment="Center"/>
                            <ComboBox x:Name="JavaReleaseBox" Grid.Row="2" Grid.Column="1"
                                      SelectionChanged="Standard_Changed"
                                      AutomationProperties.AutomationId="JavaReleaseBox" AutomationProperties.Name="Java version"/>
                        </Grid>

                        <TextBlock Style="{DynamicResource Hint}" Margin="0,8,0,0"
                                   Text="With Microsoft's compiler, C89, C99, C23 and C++11 have no setting of their own, so it uses its default for those. gcc and clang follow every choice."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Appearance" Margin="0,0,0,12">
                    <StackPanel Margin="4">
                        <TextBlock Text="Which colours FixFinder uses. It changes at once - nothing is checked again."
                                   Style="{DynamicResource Hint}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="AppearanceBox" Width="160" HorizontalAlignment="Left"
                                  SelectionChanged="Appearance_Changed"
                                  AutomationProperties.AutomationId="AppearanceBox"
                                  AutomationProperties.Name="Appearance">
                            <ComboBoxItem Content="Follow Windows"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="API credentials (both optional)" Margin="0,0,0,12">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GitHub token" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="GitHubTokenBox"
                                     AutomationProperties.AutomationId="GitHubTokenBox"
                                     AutomationProperties.Name="GitHub personal access token"
                                     Margin="0,2" Padding="2,1"/>
                        <Button    Grid.Row="0" Grid.Column="2" x:Name="ClearGitHubTokenButton"
                                   AutomationProperties.AutomationId="ClearGitHubTokenButton"
                                   Content="Clear" Padding="10,4" Margin="8,2,0,2"
                                   Click="ClearGitHubTokenButton_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GitHubTokenStateText"
                                   AutomationProperties.AutomationId="GitHubTokenStateText"
                                   Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,8"
                                   Text="Create a fine-grained token with NO permissions selected at all. FixFinder only reads public issues, and a token with no scopes still raises search from 10 requests a minute to 30, and everything else from 60 an hour to 5000. Do not paste a token with repo access - it would grant far more than this tool needs."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Stack Apps key" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="StackExchangeKeyBox"
                                     AutomationProperties.AutomationId="StackExchangeKeyBox"
                                     AutomationProperties.Name="Stack Exchange application key"
                                     Margin="0,2" Padding="2,1"/>
                        <Button    Grid.Row="3" Grid.Column="2" x:Name="ClearStackExchangeKeyButton"
                                   AutomationProperties.AutomationId="ClearStackExchangeKeyButton"
                                   Content="Clear" Padding="10,4" Margin="8,2,0,2"
                                   Click="ClearStackExchangeKeyButton_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StackExchangeKeyStateText"
                                   AutomationProperties.AutomationId="StackExchangeKeyStateText"
                                   Style="{StaticResource Hint}"/>

                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="A free key from stackapps.com raises the daily allowance from 300 requests to 10,000. It is not a login and grants no access to any account."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Where things are stored" Margin="0,0,0,12">
                    <StackPanel Margin="4">
                        <TextBlock x:Name="CredentialPathText"
                                   AutomationProperties.AutomationId="CredentialPathText"
                                   Style="{StaticResource Hint}" FontFamily="{StaticResource CodeFont}"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                   Text="Encrypted with Windows DPAPI under your account, with extra entropy. It cannot be read by another user, on another machine, or by another program running as you."/>

                        <TextBlock x:Name="CacheStateText" AutomationProperties.AutomationId="CacheStateText"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenCacheFolderButton" AutomationProperties.AutomationId="OpenCacheFolderButton"
                                    Content="Open folder" Padding="10,4" Click="OpenCacheFolderButton_Click"/>
                            <Button x:Name="ClearCacheButton" AutomationProperties.AutomationId="ClearCacheButton"
                                    Content="Clear cache" Padding="10,4" Margin="8,0,0,0" Click="ClearCacheButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Languages it can run here" Margin="0,0,0,12">
                    <StackPanel Margin="4">
                        <TextBlock x:Name="ToolchainsText"
                                   AutomationProperties.AutomationId="ToolchainsText"
                                   FontFamily="{StaticResource CodeFont}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Python and JavaScript need only their interpreter. C, C++, Java, C# and Go are compiled first, so they need a compiler - FixFinder finds Visual Studio and a JDK by itself, so neither has to be on PATH."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="What Search online sends, and where">
                    <StackPanel Margin="4">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Nothing is sent while a program is checked. Only when you press Search online on a finding is the normalised text of that error - the exception type, the message with paths, addresses and timestamps stripped out, and the quoted values from it - sent to these two services:"/>
                        <TextBlock FontFamily="{StaticResource CodeFont}" FontSize="11" Margin="8,0,0,0"
                                   Text="api.stackexchange.com&#x0a;api.github.com&#x0a;github.com  (only when fetching a .patch or .diff)"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="It never sends your source code, your file paths, your machine name, or anything you have not run. A search that was made before is answered from the cache without any network request."/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
