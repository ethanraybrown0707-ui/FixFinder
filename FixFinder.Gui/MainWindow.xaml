<Window x:Class="FixFinder.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FixFinder.Gui"
        xmlns:desktop="clr-namespace:FixFinder.Desktop;assembly=FixFinder.Desktop"
        Title="FixFinder" Height="880" Width="1260" MinHeight="640" MinWidth="1000"
        Icon="Assets/FixFinder.ico"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="OutputItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayLine}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="12,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ConsoleSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A finding as a card. What is wrong, why it matters and how to fix it come first, in words; the corrected code
            waits behind a button, so the fix can be tried before it is seen; the idea behind the mistake and the code that
            opens it in FixFinder Learn follow; and the evidence behind the finding waits under More detail.
        -->
        <DataTemplate x:Key="FindingTemplate" DataType="{x:Type local:FindingRow}">
            <Border x:Name="Card" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Margin="0,0,0,12"
                    AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Accent" Grid.Column="0" CornerRadius="11,0,0,11" Background="{DynamicResource ErrorBrush}"/>

                    <StackPanel Grid.Column="1" Margin="16,14,18,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LocationText}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{DynamicResource HintBrush}"/>

                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="SeverityPill" Style="{StaticResource Pill}"
                                        Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}">
                                    <TextBlock x:Name="SeverityLabel" Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ErrorBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource SubtleBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" ToolTip="{Binding ConfidenceTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ConfidenceDots}" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ConfidenceText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource SubtleBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}">
                                    <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                                <Border ToolTip="{Binding StatusTooltip}" AutomationProperties.AutomationId="FindingStatus"
                                        Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock desktop:InlineCode.Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock desktop:InlineCode.Text="{Binding WitnessText}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="FindingWitness"
                                   Visibility="{Binding HasWitness, Converter={StaticResource Visible}}"/>
                        <TextBlock desktop:InlineCode.Text="{Binding ConfirmationText}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.AutomationId="FindingConfirmation"
                                   Visibility="{Binding HasConfirmation, Converter={StaticResource Visible}}"/>

                        <TextBlock Text="WHAT IS WRONG" Style="{StaticResource Label}"/>
                        <TextBlock desktop:InlineCode.Text="{Binding Explanation}" Style="{StaticResource Body}"/>

                        <TextBlock Text="WHY IT MATTERS" Style="{StaticResource Label}"/>
                        <TextBlock desktop:InlineCode.Text="{Binding WhyItMatters}" Style="{StaticResource Body}"/>

                        <TextBlock Text="HOW TO FIX IT" Style="{StaticResource Label}"/>
                        <TextBlock desktop:InlineCode.Text="{Binding SuggestedFix}" Style="{StaticResource Body}"/>

                        <StackPanel Visibility="{Binding HasCorrection, Converter={StaticResource Visible}}">
                            <Button Content="{Binding CorrectionToggleText}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Tag="{Binding}" Click="ToggleCorrection_Click"
                                    AutomationProperties.AutomationId="FindingCorrectionToggle"
                                    ToolTip="Try the fix yourself first, from how to fix it above - then compare."/>

                            <StackPanel Visibility="{Binding CorrectionShown, Converter={StaticResource Visible}}">
                                <Border Background="{DynamicResource CodeBrush}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0"
                                        Visibility="{Binding HasChange, Converter={StaticResource Visible}}">
                                    <ItemsControl ItemsSource="{Binding ChangeLines}" Focusable="False"
                                                  AutomationProperties.Name="What changes"
                                                  AutomationProperties.AutomationId="FindingChange">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Padding="4,1" CornerRadius="3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Sign" Text=" " Width="12"
                                                                   FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                                                   Foreground="{DynamicResource DiffGutterBrush}"/>
                                                        <TextBlock Text="{Binding Number}" Width="34" TextAlignment="Right" Margin="0,0,10,0"
                                                                   FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                                                   Foreground="{DynamicResource DiffGutterBrush}"/>
                                                        <TextBlock x:Name="Code" local:ChangedCode.Line="{Binding}"
                                                                   FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                                                   Foreground="{DynamicResource CodeTextBrush}"
                                                                   TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffRemovedBrush}"/>
                                                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource DiffRemovedTextBrush}"/>
                                                        <Setter TargetName="Sign" Property="Text" Value="-"/>
                                                        <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource DiffRemovedTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffAddedBrush}"/>
                                                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource DiffAddedTextBrush}"/>
                                                        <Setter TargetName="Sign" Property="Text" Value="+"/>
                                                        <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource DiffAddedTextBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <StackPanel Visibility="{Binding HasExample, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding ExampleLabel}" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding CorrectedExample, Mode=OneWay}" Style="{StaticResource CodeBlock}"
                                             AutomationProperties.Name="Corrected code"/>
                                    <Button Content="Copy corrected code" Style="{StaticResource SmallButton}" Tag="{Binding}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyExample_Click"/>
                                </StackPanel>

                                <Border Visibility="{Binding HasCheck, Converter={StaticResource Visible}}"
                                        Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13"
                                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding CheckedText}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- The idea behind the mistake, and the code that opens it in FixFinder Learn. -->
                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource SuggestionBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                AutomationProperties.AutomationId="FindingIdea">
                            <StackPanel>
                                <TextBlock Text="{Binding IdeaTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Idea}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasProblemCode, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Problem code" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox Text="{Binding ProblemCodeText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                             FontFamily="{StaticResource CodeFont}" FontSize="12.5" Margin="0,0,10,0"
                                             AutomationProperties.AutomationId="FindingProblemCode" AutomationProperties.Name="Problem code"/>
                                    <Button Content="Copy" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="CopyProblemCode_Click"
                                            ToolTip="Copies the code, to paste into FixFinder Learn."/>
                                    <Button Content="Learn about this" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="OpenInLearn_Click"
                                            AutomationProperties.AutomationId="FindingOpenInLearn"
                                            ToolTip="Opens this problem in FixFinder Learn: the idea behind it, examples to run, a fix to try and questions."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Expander Header="More detail" Margin="0,12,0,0" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.AutomationId="FindingMoreDetail">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding FoundByText}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding HasFoundBy, Converter={StaticResource Visible}}"/>

                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource SuggestionBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,8,0,0"
                                        Visibility="{Binding Explains, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding ExplainsText}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               AutomationProperties.AutomationId="FindingExplains"/>
                                </Border>

                                <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,8,0,0"
                                        Visibility="{Binding Follows, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding FollowsText}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               AutomationProperties.AutomationId="FindingFollows"/>
                                </Border>

                                <TextBlock Text="WHY FIXFINDER IS THIS SURE" Style="{StaticResource Label}"/>
                                <TextBlock desktop:InlineCode.Text="{Binding EvidenceText}" Style="{StaticResource Body}"
                                           AutomationProperties.AutomationId="FindingEvidence"/>

                                <StackPanel Visibility="{Binding HasSlice, Converter={StaticResource Visible}}">
                                    <TextBlock Text="THE LINES THAT DECIDE IT" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding SliceCode, Mode=OneWay}" Style="{StaticResource CodeBlock}"
                                             AutomationProperties.Name="The lines that decide it" AutomationProperties.AutomationId="FindingSlice"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasState, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding StateHeading}" Style="{StaticResource Label}"/>

                                    <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,6"
                                            AutomationProperties.AutomationId="FindingState" AutomationProperties.Name="What the line did">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="#" Width="34" FontFamily="{StaticResource CodeFont}" FontSize="12"
                                                           Foreground="{DynamicResource HintBrush}"/>
                                                <ItemsControl ItemsSource="{Binding StateColumns}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" MinWidth="110" Margin="0,0,12,0"
                                                                       FontFamily="{StaticResource CodeFont}" FontSize="12"
                                                                       Foreground="{DynamicResource HintBrush}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding StateRows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="StateRow" CornerRadius="3" Padding="0,1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Number}" Width="34"
                                                                           FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <ItemsControl ItemsSource="{Binding Values}" Focusable="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" MinWidth="110" Margin="0,0,12,0"
                                                                                       FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                                                                       Foreground="{DynamicResource TextBrush}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsWhereItFailed}" Value="True">
                                                                <Setter TargetName="StateRow" Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding StateCutNote}" Margin="34,4,0,0" FontSize="11.5"
                                                       Foreground="{DynamicResource HintBrush}"
                                                       Visibility="{Binding StateWasCut, Converter={StaticResource Visible}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasVerification, Converter={StaticResource Visible}}">
                                    <TextBlock Text="VERIFICATION" Style="{StaticResource Label}"/>
                                    <ItemsControl ItemsSource="{Binding VerificationLines}" Focusable="False"
                                                  AutomationProperties.Name="Verification"
                                                  AutomationProperties.AutomationId="FindingVerification">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock x:Name="Mark" Text="{Binding Mark}" Width="18"
                                                               FontSize="12.5" Foreground="{DynamicResource HintBrush}"/>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="VerdictText" Text="{Binding VerificationSummary}" Margin="18,4,0,0"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"
                                               AutomationProperties.AutomationId="FindingVerificationSummary">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFixChanges, Converter={StaticResource Visible}}">
                                    <TextBlock Text="WHAT THE FIX CHANGES" Style="{StaticResource Label}"/>
                                    <ItemsControl ItemsSource="{Binding FixChanges}" Focusable="False"
                                                  AutomationProperties.Name="What the fix changes" AutomationProperties.AutomationId="FindingFixChanges">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock desktop:InlineCode.Text="{Binding}" Style="{StaticResource Body}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasOrigin, Converter={StaticResource Visible}}">
                                    <TextBlock Text="WHERE THIS FIX CAME FROM" Style="{StaticResource Label}"/>
                                    <TextBlock desktop:InlineCode.Text="{Binding OriginText}" Style="{StaticResource Body}"
                                               AutomationProperties.AutomationId="FindingOrigin"/>
                                    <Button Content="{Binding OriginUrl}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                            Tag="{Binding}" Click="OpenOrigin_Click" Margin="0,2,0,0"
                                            AutomationProperties.AutomationId="FindingOriginLink"
                                            ToolTip="Opens the page this fix was taken from, so you can judge it yourself."
                                            Visibility="{Binding HasOriginLink, Converter={StaticResource Visible}}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFurtherReading, Converter={StaticResource Visible}}">
                                    <TextBlock Text="READ MORE ABOUT THIS" Style="{StaticResource Label}"/>
                                    <Button Content="{Binding FurtherReadingText}" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Tag="{Binding}" Click="OpenFurtherReading_Click"
                                            AutomationProperties.AutomationId="FindingFurtherReading"
                                            ToolTip="{Binding FurtherReadingUrl}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasWeakness, Converter={StaticResource Visible}}">
                                    <TextBlock Text="CLASSIFIED AS (MITRE CWE)" Style="{StaticResource Label}"/>
                                    <Button Content="{Binding WeaknessText}" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Tag="{Binding}" Click="OpenWeakness_Click"
                                            AutomationProperties.AutomationId="FindingWeakness"
                                            ToolTip="{Binding WeaknessUrl}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Search online" Style="{StaticResource SmallButton}" Tag="{Binding}"
                                    Visibility="{Binding CanSearch, Converter={StaticResource Visible}}" Click="SearchOnline_Click"
                                    ToolTip="Look for questions about this same error on GitHub and Stack Overflow. Only the error's text is sent."/>
                            <Button Content="Show in folder" Style="{StaticResource SmallButton}" Tag="{Binding}"
                                    Click="ShowInFolder_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SeverityText}" Value="Warning">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource WarningBrush}"/>
                    <Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                    <Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
                    <Setter TargetName="SeverityLabel" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityText}" Value="Suggestion">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SuggestionBrush}"/>
                    <Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource SuggestionSoftBrush}"/>
                    <Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource SuggestionBorderBrush}"/>
                    <Setter TargetName="SeverityLabel" Property="Foreground" Value="{DynamicResource SuggestionBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton"
                        Style="{StaticResource QuietButton}" VerticalAlignment="Center" Click="SettingsButton_Click"
                        ToolTip="How long a run is given, the colours, the optional keys for searching online, and which languages this computer can run.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="38" Height="38" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FixFinder" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Checks a program's syntax and logic together, and shows how to fix every mistake it finds."
                                   FontSize="12" Foreground="{DynamicResource HintBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Rectangle Grid.Row="1" Height="3" Fill="{DynamicResource BrandBlendBrush}"/>

        <Grid Grid.Row="2" Margin="20,18,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Program" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                            <Border x:Name="DropZone" AutomationProperties.AutomationId="DropZone" Background="Transparent">
                                <Grid>
                                    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5 3" SnapsToDevicePixels="True">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Stroke" Value="#BFCADA"/>
                                                <Setter Property="Fill" Value="{DynamicResource SubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Fill" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <StackPanel x:Name="NothingChosenPanel" Margin="12,18">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="26" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Drop a program file here" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock Text="or choose one of these" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,12"/>

                                        <!-- Three ways in, side by side and alike: a file, a folder, or the code itself. -->
                                        <UniformGrid Columns="3" Margin="-4,0">
                                            <Button x:Name="ChooseFileButton" AutomationProperties.AutomationId="ChooseFileButton"
                                                    AutomationProperties.Name="Choose a file" Style="{StaticResource SourceTile}"
                                                    Click="ChooseFileButton_Click" ToolTip="Pick the program's file.">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SourceTileIcon}" Text="&#xE8A5;"/>
                                                    <TextBlock Style="{StaticResource SourceTileLabel}" Text="File…"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ChooseFolderButton" AutomationProperties.AutomationId="ChooseFolderButton"
                                                    AutomationProperties.Name="Choose a folder" Style="{StaticResource SourceTile}"
                                                    Click="ChooseFolderButton_Click"
                                                    ToolTip="Check every program in a folder. Build output, dependencies and caches are left alone.">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SourceTileIcon}" Text="&#xE8B7;"/>
                                                    <TextBlock Style="{StaticResource SourceTileLabel}" Text="Folder…"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PasteCodeButton" AutomationProperties.AutomationId="PasteCodeButton"
                                                    AutomationProperties.Name="Paste code" Style="{StaticResource SourceTile}"
                                                    Click="PasteCodeButton_Click"
                                                    ToolTip="For code that is hard to find as a file: paste it in, and press Check this code.">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SourceTileIcon}" Text="&#xE77F;"/>
                                                    <TextBlock Style="{StaticResource SourceTileLabel}" Text="Paste code"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>

                                    <StackPanel x:Name="ChosenPanel" Margin="16,14" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE943;" FontSize="18"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="ChosenFileText" AutomationProperties.AutomationId="ChosenFileText"
                                                       FontFamily="{StaticResource CodeFont}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock x:Name="ChosenFolderText" AutomationProperties.AutomationId="ChosenFolderText"
                                                   Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ChosenLanguageText" AutomationProperties.AutomationId="ChosenLanguageText"
                                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="HowItRunsText" AutomationProperties.AutomationId="HowItRunsText"
                                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="CheckAgainButton" AutomationProperties.AutomationId="CheckAgainButton"
                                                    Content="Check again" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Padding="12,4"
                                                    Click="CheckAgainButton_Click"
                                                    ToolTip="Compiles and runs it again, and reads its code again - after you change it, or give it input and what it should print."/>
                                            <Button x:Name="ChooseAnotherButton" AutomationProperties.AutomationId="ChooseAnotherButton"
                                                    AutomationProperties.Name="Choose another file" Style="{StaticResource SmallButton}"
                                                    Click="ChooseFileButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8A5;"/>
                                                    <TextBlock Text="Another file…"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PasteInsteadButton" AutomationProperties.AutomationId="PasteInsteadButton"
                                                    AutomationProperties.Name="Paste code instead" Style="{StaticResource SmallButton}"
                                                    Click="PasteCodeButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE77F;"/>
                                                    <TextBlock Text="Paste code"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="PastePanel" Margin="14,12" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="16"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Paste the program's code" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                                                   Text="Then press Check this code. Its language is worked out from the code - or choose it, when the code does not show which it is. It is saved as a file of its own and checked like any program."/>
                                        <TextBox x:Name="PastedCodeBox" AutomationProperties.AutomationId="PastedCodeBox"
                                                 AutomationProperties.Name="Pasted code" Style="{StaticResource InputBox}"
                                                 FontSize="12.5" Height="260" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 SpellCheck.IsEnabled="False"/>
                                        <TextBlock x:Name="PastedSavedAsText" AutomationProperties.AutomationId="PastedSavedAsText"
                                                   Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                        <DockPanel Margin="0,10,0,0">
                                            <Button DockPanel.Dock="Right" x:Name="CheckPastedButton" AutomationProperties.AutomationId="CheckPastedButton"
                                                    Content="Check this code" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,4"
                                                    Click="CheckPastedButton_Click"/>
                                            <ComboBox x:Name="PastedLanguageBox" AutomationProperties.AutomationId="PastedLanguageBox"
                                                      AutomationProperties.Name="Language of the pasted code" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="ClearPastedCodeButton" AutomationProperties.AutomationId="ClearPastedCodeButton"
                                                    AutomationProperties.Name="Clear" Style="{StaticResource SmallButton}"
                                                    Click="ClearPastedCodeButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE894;"/>
                                                    <TextBlock Text="Clear"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ChooseFileInsteadButton" AutomationProperties.AutomationId="ChooseFileInsteadButton"
                                                    AutomationProperties.Name="Choose a file instead" Style="{StaticResource SmallButton}"
                                                    Click="ChooseFileButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8A5;"/>
                                                    <TextBlock Text="A file instead…"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="FolderPanel" Margin="16,14" Visibility="Collapsed">
                                        <TextBlock x:Name="FolderSummaryText" AutomationProperties.AutomationId="FolderSummaryText"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FolderProgressText" AutomationProperties.AutomationId="FolderProgressText"
                                                   Style="{StaticResource Hint}" Margin="0,4,0,8"/>

                                        <ListBox x:Name="FolderList" AutomationProperties.AutomationId="FolderList"
                                                 MaxHeight="220" BorderThickness="0" Background="Transparent"
                                                 SelectionChanged="FolderList_SelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel MinWidth="240" Margin="0,1">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" VerticalAlignment="Center"
                                                                   Margin="10,0,0,0" FontSize="12" Foreground="{Binding StatusBrush}"/>
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource CodeFont}" FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Button x:Name="ChooseAnotherFolderButton" AutomationProperties.AutomationId="ChooseAnotherFolderButton"
                                                AutomationProperties.Name="Choose another folder" Style="{StaticResource SmallButton}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="ChooseFolderButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8B7;"/>
                                                <TextBlock Text="Another folder…"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>


                    <Border Style="{StaticResource Card}">
                        <Expander x:Name="OptionsExpander" AutomationProperties.AutomationId="OptionsExpander" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Input and expected output" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Optional. Give what it should print to check its output too." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="ARGUMENTS" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ArgumentsTextBox" AutomationProperties.AutomationId="ArgumentsTextBox"
                                         AutomationProperties.Name="Program arguments" Style="{StaticResource InputBox}"/>

                                <TextBlock Text="INPUT  ·  ONE ANSWER PER LINE" Style="{StaticResource Label}"/>
                                <TextBox x:Name="InputTextBox" AutomationProperties.AutomationId="InputTextBox"
                                         AutomationProperties.Name="Input for the first run" Style="{StaticResource InputBox}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="64" VerticalScrollBarVisibility="Auto"/>

                                <TextBlock Text="WHAT IT SHOULD PRINT" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ExpectedOutputTextBox" AutomationProperties.AutomationId="ExpectedOutputTextBox"
                                         AutomationProperties.Name="Expected output for the first run" Style="{StaticResource InputBox}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="64" VerticalScrollBarVisibility="Auto"/>

                                <ItemsControl x:Name="ExtraRunsList" AutomationProperties.AutomationId="ExtraRunsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,4,0,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource LinkButton}"
                                                                AutomationProperties.Name="Remove this run" Tag="{Binding}" Click="RemoveRunButton_Click"
                                                                VerticalAlignment="Bottom"/>
                                                        <TextBlock Text="ANOTHER RUN  ·  INPUT" Style="{StaticResource Label}"/>
                                                    </DockPanel>
                                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Input for another run"
                                                             Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="NoWrap" Height="50"
                                                             VerticalScrollBarVisibility="Auto"/>
                                                    <TextBlock Text="WHAT IT SHOULD PRINT" Style="{StaticResource Label}"/>
                                                    <TextBox Text="{Binding Expected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expected output for another run"
                                                             Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="NoWrap" Height="50"
                                                             VerticalScrollBarVisibility="Auto"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="AddRunButton" AutomationProperties.AutomationId="AddRunButton"
                                        Content="+ Add another run with different input" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddRunButton_Click"/>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ActivityPill" Style="{StaticResource Pill}" Margin="0,0,10,0"
                                Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                AutomationProperties.AutomationId="ActivityPill"
                                AutomationProperties.Name="{Binding Text, ElementName=ActivityText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ActivityIcon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                                           Margin="0,0,7,0" Foreground="{DynamicResource HintBrush}"/>
                                <TextBlock x:Name="ActivityText" Text="Not running" FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="ActivityProgress" Style="{StaticResource ThinProgress}"
                                             Width="34" Height="3" Margin="8,0,0,0" IsIndeterminate="True"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>


                        <Button x:Name="CopyReportButton" AutomationProperties.AutomationId="CopyReportButton"
                                Style="{StaticResource QuietButton}" IsEnabled="False" Click="CopyReportButton_Click"
                                ToolTip="Copies every finding as plain text.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Copy report"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveReportButton" AutomationProperties.AutomationId="SaveReportButton"
                                Style="{StaticResource QuietButton}" IsEnabled="False" Click="SaveReportButton_Click" Margin="6,0,0,0"
                                ToolTip="Saves the whole report - every finding, its fix and how it was checked - as a web page to keep, print or hand in.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Save report…"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" AutomationProperties.AutomationId="StopButton"
                                Margin="8,0,0,0" Visibility="Collapsed" Click="StopButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0"
                                           Foreground="{DynamicResource ErrorBrush}"/>
                                <TextBlock Text="Stop"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Report" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReportSubtitleText" AutomationProperties.AutomationId="ReportSubtitleText"
                                   Style="{StaticResource Hint}" Text="Nothing checked yet."/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                        <Grid>
                            <DockPanel Margin="16,12">
                                <TextBlock x:Name="SyntaxIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE943;"
                                           FontSize="20" Foreground="{DynamicResource HintBrush}" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Syntax check" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SyntaxStatusText" AutomationProperties.AutomationId="SyntaxStatusText"
                                               Style="{StaticResource Hint}" Text="Waiting for a program" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="SyntaxProgress" Style="{StaticResource ThinProgress}" VerticalAlignment="Bottom"
                                         IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,12,1"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                        <Grid>
                            <DockPanel Margin="16,12">
                                <TextBlock x:Name="LogicIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE9D9;"
                                           FontSize="20" Foreground="{DynamicResource HintBrush}" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Logic check" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LogicStatusText" AutomationProperties.AutomationId="LogicStatusText"
                                               Style="{StaticResource Hint}" Text="Waiting for a program" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="LogicProgress" Style="{StaticResource ThinProgress}" VerticalAlignment="Bottom"
                                         IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,12,1"/>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2">
                    <!-- This check beside the last one of the same program: what was fixed, what is new, what is still there. -->
                    <Border x:Name="SinceLastPanel" AutomationProperties.AutomationId="SinceLastPanel" Visibility="Collapsed"
                            Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="SinceLastText" AutomationProperties.AutomationId="SinceLastText"
                                       TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ItemsControl x:Name="FixedSinceLastList" AutomationProperties.AutomationId="FixedSinceLastList"
                                          Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoftBrush}"
                                                    BorderBrush="{DynamicResource SuccessBorderBrush}">
                                                <TextBlock Text="Fixed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                            <TextBlock desktop:InlineCode.Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Where}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource HintBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ViewTabs" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                        <RadioButton x:Name="ProblemsTab" AutomationProperties.AutomationId="ProblemsTab" GroupName="View"
                                     Style="{StaticResource ViewTab}" IsChecked="True" Checked="View_Checked"
                                     ToolTip="What is wrong with the program, or likely to go wrong."/>
                        <RadioButton x:Name="EfficiencyTab" AutomationProperties.AutomationId="EfficiencyTab" GroupName="View"
                                     Style="{StaticResource ViewTab}" Checked="View_Checked"
                                     ToolTip="Ways the program could do less work as its data grows. None of them is a mistake."/>
                    </StackPanel>

                    <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel x:Name="SeverityFilters" Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" AutomationProperties.AutomationId="FilterAll" GroupName="Filter"
                                         Style="{StaticResource FilterPill}" IsChecked="True" Checked="Filter_Checked"/>
                            <RadioButton x:Name="FilterErrors" AutomationProperties.AutomationId="FilterErrors" GroupName="Filter"
                                         Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                            <RadioButton x:Name="FilterWarnings" AutomationProperties.AutomationId="FilterWarnings" GroupName="Filter"
                                         Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                            <RadioButton x:Name="FilterSuggestions" AutomationProperties.AutomationId="FilterSuggestions" GroupName="Filter"
                                         Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="EfficiencyIntro" AutomationProperties.AutomationId="EfficiencyIntro" Visibility="Collapsed"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource SuggestionBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Ways this program could do less work as its data grows. Each one says what FixFinder noticed and why it costs time and, where FixFinder can show that a change gives exactly the same answers, what to change and why it is quicker. None of them is a mistake: the program is right either way."/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="NotesList" Grid.Row="3" AutomationProperties.AutomationId="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource SuggestionBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="4">
                    <ScrollViewer x:Name="FindingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FindingsList" AutomationProperties.AutomationId="FindingsList"
                                      ItemTemplate="{StaticResource FindingTemplate}"/>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyState" AutomationProperties.AutomationId="EmptyState" VerticalAlignment="Center"
                                HorizontalAlignment="Center" MaxWidth="440">
                        <Image x:Name="EmptyImage" Source="{StaticResource LogoImage}" Width="64" Height="64" Opacity="0.9"/>
                        <TextBlock x:Name="EmptyTitleText" AutomationProperties.AutomationId="EmptyTitleText"
                                   Text="Check a program" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                        <TextBlock x:Name="EmptyBodyText" AutomationProperties.AutomationId="EmptyBodyText"
                                   Style="{StaticResource Body}" TextAlignment="Center"
                                   Text="Choose a file - or paste its code in. FixFinder works out its language, compiles and runs it while it reads the code for logic mistakes, and lists every problem with how sure it is, where it is, why it matters and how to fix it."/>
                    </StackPanel>
                </Grid>

                <Expander Grid.Row="5" x:Name="DetailsExpander" AutomationProperties.AutomationId="DetailsExpander"
                          IsExpanded="False" Margin="0,8,0,0">
                    <Expander.Header>
                        <TextBlock Text="What the program printed" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Expander.Header>

                    <Border Background="{DynamicResource ConsoleBrush}" CornerRadius="10" Margin="0,8,0,0" Padding="0,8" Height="170">
                        <ListBox x:Name="OutputListBox" AutomationProperties.AutomationId="OutputListBox"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource CodeFont}" FontSize="12"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource OutputItemContainerStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLine}" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ConsoleErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Expander>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="OpenLogButton" AutomationProperties.AutomationId="OpenLogButton"
                        Content="Open log" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="OpenLogButton_Click"/>
                <TextBlock x:Name="LogPathText" AutomationProperties.AutomationId="LogPathText"
                           Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Text="FixFinder never changes your files. Fixes are shown for you to copy."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
