<Window x:Class="FixFinder.Learn.LearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FixFinder.Learn"
        xmlns:desktop="clr-namespace:FixFinder.Desktop;assembly=FixFinder.Desktop"
        Title="FixFinder Learn" Height="860" Width="1200" MinHeight="560" MinWidth="900"
        Icon="Assets/FixFinderLearn.ico"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <!-- A worked example: the program with the mistake, the program put right, and running either one here. -->
        <DataTemplate x:Key="ExampleTemplate" DataType="{x:Type local:ExampleCard}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="THE PROGRAM WITH THE MISTAKE" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding BrokenCode, Mode=OneWay}" Style="{StaticResource CodeBlock}"
                             AutomationProperties.Name="The program with the mistake"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Run it" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                Tag="{Binding}" Click="RunBroken_Click" VerticalAlignment="Top"
                                ToolTip="Runs it on this computer, as FixFinder would, and shows what it does."/>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="What it does: " FontWeight="SemiBold"/><Run Text="{Binding BrokenDoes, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Text="{Binding BrokenRan, Mode=OneWay}" Style="{StaticResource CodeBlock}" Margin="0,8,0,0"
                             AutomationProperties.Name="What running it did"
                             Visibility="{Binding HasBrokenRan, Converter={StaticResource Visible}}"/>

                    <TextBlock Text="PUT RIGHT" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBox Text="{Binding FixedCode, Mode=OneWay}" Style="{StaticResource CodeBlock}"
                             AutomationProperties.Name="The program put right"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Run it" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                Tag="{Binding}" Click="RunFixed_Click" VerticalAlignment="Top"
                                ToolTip="Runs it on this computer, as FixFinder would, and shows what it does."/>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="What it does: " FontWeight="SemiBold"/><Run Text="{Binding FixedDoes, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Text="{Binding FixedRan, Mode=OneWay}" Style="{StaticResource CodeBlock}" Margin="0,8,0,0"
                             AutomationProperties.Name="What running it did"
                             Visibility="{Binding HasFixedRan, Converter={StaticResource Visible}}"/>

                    <TextBlock Text="WHAT CHANGED" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                    <TextBlock desktop:InlineCode.Text="{Binding WhatChanged}" Style="{StaticResource Body}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A question: what it asks, the code it is about, its answers, and what checking the one picked said. -->
        <DataTemplate x:Key="QuestionTemplate" DataType="{x:Type local:QuestionCard}">
            <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Asks}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Code, Mode=OneWay}" Style="{StaticResource CodeBlock}" Margin="0,0,0,10"
                             AutomationProperties.Name="The code the question is about"
                             Visibility="{Binding HasCode, Converter={StaticResource Visible}}"/>
                    <ItemsControl ItemsSource="{Binding Answers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AnswerChoice}">
                                <RadioButton Style="{StaticResource AnswerChoice}" GroupName="{Binding Group}"
                                             IsChecked="{Binding IsPicked, Mode=TwoWay}" AutomationProperties.Name="{Binding Text}">
                                    <Grid>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   Visibility="{Binding IsWords, Converter={StaticResource Visible}}"/>
                                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                                                   TextWrapping="NoWrap"
                                                   Visibility="{Binding IsCode, Converter={StaticResource Visible}}"/>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Check" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Tag="{Binding}" Click="CheckAnswer_Click"/>
                    <Border Margin="0,10,0,0" CornerRadius="8" Padding="10,7" BorderThickness="1"
                            Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WasRight}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock desktop:InlineCode.Text="{Binding Result}" TextWrapping="Wrap" FontSize="12.5"
                                   AutomationProperties.AutomationId="QuestionResult"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="24,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource LearnLogoImage}" Width="38" Height="38" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FixFinder Learn" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="The idea behind each mistake FixFinder finds - with examples to run, a fix to try and questions to check you have it."
                               FontSize="12" Foreground="{DynamicResource HintBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Rectangle Grid.Row="1" Height="3" Fill="{DynamicResource BrandBlendBrush}"/>

        <Grid Grid.Row="2" Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Open a problem" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                       Text="Paste the code FixFinder gave a problem it found - it looks like FF-PY-DIVZERO-K7Q2MXA."/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="OpenCodeButton" AutomationProperties.AutomationId="OpenCodeButton"
                                        Content="Open" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True"
                                        Click="OpenCodeButton_Click"/>
                                <TextBox x:Name="CodeBox" AutomationProperties.AutomationId="CodeBox"
                                         AutomationProperties.Name="Problem code" Style="{StaticResource InputBox}" FontSize="13"/>
                            </DockPanel>
                            <TextBlock x:Name="CodeProblemText" AutomationProperties.AutomationId="CodeProblemText"
                                       Style="{StaticResource Hint}" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Problems FixFinder found" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="NoProblemsText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="None yet. The problems FixFinder finds on this computer are listed here, newest first."/>
                            <ItemsControl x:Name="ProblemsList" AutomationProperties.AutomationId="ProblemsList" Margin="-8,6,-8,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProblemChoice}">
                                        <Button Style="{StaticResource ListChoice}" Tag="{Binding}" Click="OpenProblem_Click"
                                                AutomationProperties.Name="{Binding Title}">
                                            <StackPanel>
                                                <TextBlock desktop:InlineCode.Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                                <TextBlock Text="{Binding Where}" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="ForgetProblemsButton" AutomationProperties.AutomationId="ForgetProblemsButton"
                                    Content="Forget these" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Click="ForgetProblemsButton_Click"
                                    ToolTip="FixFinder keeps what it said of each problem, and the line of code it is on, on this computer for FixFinder Learn. This deletes all of it."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Lessons" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox"
                                      AutomationProperties.Name="Language of the lessons" Margin="0,8,0,8"
                                      SelectionChanged="LanguageBox_SelectionChanged"/>
                            <ItemsControl x:Name="LessonsList" AutomationProperties.AutomationId="LessonsList" Margin="-8,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LessonChoice}">
                                        <Button Style="{StaticResource ListChoice}" Tag="{Binding}" Click="OpenLesson_Click"
                                                AutomationProperties.Name="{Binding Title}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Style="{StaticResource Hint}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <StackPanel x:Name="EmptyState" AutomationProperties.AutomationId="LearnEmptyState" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="460">
                    <Image Source="{StaticResource LearnLogoImage}" Width="64" Height="64" Opacity="0.9"/>
                    <TextBlock Text="Learn the idea behind a mistake" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                    <TextBlock Style="{StaticResource Body}" TextAlignment="Center"
                               Text="Open a problem FixFinder found with its code, or choose a lesson on the left. Each lesson shows the mistake happening in programs you can run, lets you try the fix yourself, and asks a few questions to check it has gone in."/>
                </StackPanel>

                <ScrollViewer x:Name="LessonScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="LessonPanel" Margin="0,0,8,0">
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource SuggestionBorderBrush}">
                                <TextBlock x:Name="LanguageText" AutomationProperties.AutomationId="LessonLanguageText" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="ConceptTitleText" AutomationProperties.AutomationId="ConceptTitleText"
                                       FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>

                        <Border x:Name="YourProblemCard" AutomationProperties.AutomationId="YourProblemCard" Style="{StaticResource Card}"
                                Visibility="Collapsed" BorderBrush="{DynamicResource ErrorBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="YOUR PROBLEM" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ProblemTitleText" desktop:InlineCode.Text="" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ProblemWhereText" Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                                <TextBox x:Name="ProblemLineBox" Style="{StaticResource CodeBlock}" AutomationProperties.Name="Your line of code"/>
                                <TextBlock Text="WHAT IS WRONG" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="ProblemExplanationText" Style="{StaticResource Body}"/>
                                <TextBlock Text="WHY IT MATTERS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="ProblemWhyText" Style="{StaticResource Body}"/>
                                <TextBlock Text="HOW TO FIX IT" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="ProblemFixText" Style="{StaticResource Body}"/>
                                <StackPanel x:Name="ProblemChangePanel">
                                    <TextBlock Text="THE CHANGE FIXFINDER FOUND" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="ProblemChangeBox" Style="{StaticResource CodeBlock}" AutomationProperties.Name="The change FixFinder found"/>
                                </StackPanel>
                                <TextBlock x:Name="ProblemOthersText" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NotKeptHereCard" AutomationProperties.AutomationId="NotKeptHereCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Body}"
                                       Text="FixFinder keeps what it said of a problem only on the computer that found it, and this code's problem is not kept here - so here is the idea behind it, without your own line of code."/>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="THE IDEA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="IdeaText" AutomationProperties.AutomationId="IdeaText" Style="{StaticResource Body}" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="InThisLanguageCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="InThisLanguageLabel" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InThisLanguageText" AutomationProperties.AutomationId="InThisLanguageText" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NoLessonCard" AutomationProperties.AutomationId="NoLessonCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="NoLessonText" Style="{StaticResource Body}"/>
                                <WrapPanel x:Name="OtherLanguagesPanel" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ExamplesList" AutomationProperties.AutomationId="ExamplesList"
                                      ItemTemplate="{StaticResource ExampleTemplate}" Focusable="False"/>

                        <Border x:Name="TryItCard" AutomationProperties.AutomationId="TryItCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Try it yourself" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="TryItIntroText" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                                <TextBox x:Name="TryItBox" AutomationProperties.AutomationId="TryItBox" AutomationProperties.Name="Your fix"
                                         Style="{StaticResource InputBox}" FontSize="12.5" MinHeight="140" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         SpellCheck.IsEnabled="False"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CheckFixButton" AutomationProperties.AutomationId="CheckFixButton" Content="Check my fix"
                                            Style="{StaticResource PrimaryButton}" Click="CheckFixButton_Click"/>
                                    <Button x:Name="StartAgainButton" Content="Start again" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Click="StartAgainButton_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TryItResultText" AutomationProperties.AutomationId="TryItResultText"
                                           desktop:InlineCode.Text="" Style="{StaticResource Body}" Margin="0,10,0,0" Visibility="Collapsed"/>
                                <TextBox x:Name="TryItOutputBox" Style="{StaticResource CodeBlock}" Margin="0,8,0,0" Visibility="Collapsed"
                                         AutomationProperties.Name="What running your fix did"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="QuestionsCard" AutomationProperties.AutomationId="QuestionsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="QuestionsProgressText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Check your understanding" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                           Text="Every answer here was worked out by running the programs, so a right answer is what really happens."/>
                                <ItemsControl x:Name="QuestionsList" AutomationProperties.AutomationId="QuestionsList"
                                              ItemTemplate="{StaticResource QuestionTemplate}" Focusable="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
