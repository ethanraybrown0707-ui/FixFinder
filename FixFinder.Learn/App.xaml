<Application x:Class="FixFinder.Learn.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The styles FixFinder Learn shares with FixFinder. Theme.Apply adds the colours beside it. -->
                <ResourceDictionary Source="pack://application:,,,/FixFinder.Desktop;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- FixFinder's tile with an open book on it, as make-icon.py draws the icon. -->
            <DrawingImage x:Key="LearnLogoImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{DynamicResource LogoTileBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="4,4,92,92" RadiusX="24" RadiusY="24"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="White" Geometry="M 17,33 L 47,39 L 47,75 L 17,69 Z"/>
                        <GeometryDrawing Brush="White" Geometry="M 53,39 L 83,33 L 83,69 L 53,75 Z"/>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- A choice among a question's answers: a card that shows when it is picked. -->
            <Style x:Key="AnswerChoice" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A lesson or a problem in the lists on the left: plain text that lights up under the pointer. -->
            <Style x:Key="ListChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
